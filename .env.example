# Docker Compose 暴露到服务器的端口
GATEWAY_PORT=8787
GATEWAY_IMAGE_TAG=latest

# 公网远程管理必须配置 Authentik OIDC 和 HTTPS
AUTHENTIK_ISSUER_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=
AUTHENTIK_SCOPES=openid profile email
AUTHENTIK_TOKEN_AUTH_METHOD=
AUTHENTIK_SESSION_TTL_SECONDS=28800
AUTHENTIK_COOKIE_SECURE=
AUTHENTIK_POST_LOGOUT_REDIRECT_URI=

# 逗号分隔的反向代理精确 IP，例如 172.18.0.1；不要填写 CIDR
TRUSTED_PROXY_ADDRESSES=