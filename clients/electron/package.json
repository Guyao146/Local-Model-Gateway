{
  "name": "local-model-gateway-electron",
  "version": "1.2.6",
  "private": true,
  "description": "Electron desktop client for Local Model Gateway",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "37.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "cn.mcylyr.localmodelgateway.electron",
    "productName": "Local Model Gateway Electron",
    "asar": true,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "gateway", "to": "gateway" }],
    "directories": { "output": "dist" },
    "win": {
      "artifactName": "Local-Model-Gateway-${version}-Electron-win-${arch}-${name}.${ext}",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Local-Model-Gateway-${version}-Electron-win-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Local-Model-Gateway-${version}-Electron-win-${arch}-Portable.${ext}"
    }
  }
}